# ---- Python ------------------------------------------------------------------
__pycache__/
# start.bat's private environment
.venv/
# your settings (the game folder in use): personal, never shipped
settings.json
# the script debugger's recovery note while it is attached to a game (rf4s_modkit.scriptdbg)
scriptdbg-recovery.json
# the window icon, decoded from your game copy (app_icon.py): game art, never shipped
*.py[cod]

# ---- regenerated / scratch output ---------------------------------------------
# map editor: rendered mesh images (rf4s_modkit.mobj_meshes.rasterize_cached)
cache/
# generator output (gen_map_names_json / gen_minimap_sheets / gen_mobj_param_csv, world_stitch)
out/
world_out/
# selftest.py's cache of corpus scan results
.selftest_cache.json
# old backups and ad-hoc dumps
*.bak
*.bak.json

# ---- game data: never commit (the toolkit reads it from your own copy) ---------
Bundle/
*.mbundle
*.rf4m
*.texture
*.model
*.bntx
*.bfres
*.mc
rf3mc.*
*.sav
*.bin
emdeb_extra.json

# ---- editor / OS clutter --------------------------------------------------------
.vscode/
.idea/
Thumbs.db
.DS_Store

# design drafts and their prototypes / images: local notes, not shipped
drafts/

# opcode table generator and its output: local only
OPCODE_TABLE.md
gen_opcode_table.py
