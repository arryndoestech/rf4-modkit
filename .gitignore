# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]

# ---- regenerated / scratch output ---------------------------------------------
# selftest.py's cache of corpus scan results
.selftest_cache.json
# Ghidra: the SLEIGH module is regenerated by `python ghidra/gen_sleigh_module.py`,
# the listing plan by `python ghidra/gen_ghidra_plan.py --banks ...` (it inlines game
# dialogue, so it must not be committed)
ghidra/RF4MC/
ghidra/rf4_cutscene_plan.json
ghidra/*.plan.json
# old backups and ad-hoc dumps
*.bak
*.bak.json
_em_special_entries.txt

# ---- game data: never commit (the toolkit reads it from your own copy) ---------
Bundle/
*.mbundle
*.rf4m
*.texture
*.model
*.bntx
*.bfres
*.mc
rf3mc.*
*.sav
*.bin
emdeb_extra.json

# ---- editor / OS clutter --------------------------------------------------------
.vscode/
.idea/
Thumbs.db
.DS_Store
