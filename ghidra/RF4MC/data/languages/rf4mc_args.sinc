# Counted operand list (expression-pool offsets, u16 each) - fixed
# constructors per argc; SLEIGH recursion is avoided on purpose (a
# context-counted recursive table hangs the 12.1.2 compiler).
define token awt1 (16) arg1=(0,15);
define token awt2 (16) arg2=(0,15);
define token awt3 (16) arg3=(0,15);
define token awt4 (16) arg4=(0,15);
define token awt5 (16) arg5=(0,15);
define token awt6 (16) arg6=(0,15);
define token awt7 (16) arg7=(0,15);
define token awt8 (16) arg8=(0,15);
define token awt9 (16) arg9=(0,15);
define token awt10 (16) arg10=(0,15);
define token awt11 (16) arg11=(0,15);
define token awt12 (16) arg12=(0,15);
define token awt13 (16) arg13=(0,15);
define token awt14 (16) arg14=(0,15);
define token awt15 (16) arg15=(0,15);
define token awt16 (16) arg16=(0,15);
args: is cnt16=0 { }
args: arg1 is cnt16=1; arg1 { }
args: arg1,arg2 is cnt16=2; arg1; arg2 { }
args: arg1,arg2,arg3 is cnt16=3; arg1; arg2; arg3 { }
args: arg1,arg2,arg3,arg4 is cnt16=4; arg1; arg2; arg3; arg4 { }
args: arg1,arg2,arg3,arg4,arg5 is cnt16=5; arg1; arg2; arg3; arg4; arg5 { }
args: arg1,arg2,arg3,arg4,arg5,arg6 is cnt16=6; arg1; arg2; arg3; arg4; arg5; arg6 { }
args: arg1,arg2,arg3,arg4,arg5,arg6,arg7 is cnt16=7; arg1; arg2; arg3; arg4; arg5; arg6; arg7 { }
args: arg1,arg2,arg3,arg4,arg5,arg6,arg7,arg8 is cnt16=8; arg1; arg2; arg3; arg4; arg5; arg6; arg7; arg8 { }
args: arg1,arg2,arg3,arg4,arg5,arg6,arg7,arg8,arg9 is cnt16=9; arg1; arg2; arg3; arg4; arg5; arg6; arg7; arg8; arg9 { }
